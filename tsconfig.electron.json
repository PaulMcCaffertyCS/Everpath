{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "outDir": "dist-electron",
    "rootDir": "src"
  },
  "include": [
    "src/main/**/*.ts",
    "src/shared/**/*.ts"
  ]
}